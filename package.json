    "sandbox:lint": "scripts/sandbox.sh --ro -- npm run lint",
    "sandbox:dev": "scripts/sandbox.sh --net --tty -- npm run dev",
    "sandbox:shell": "scripts/sandbox.sh --tty -- bash"
